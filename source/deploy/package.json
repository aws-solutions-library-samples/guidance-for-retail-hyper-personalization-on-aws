{
    "name": "deploy",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "tsc",
        "test": "jest --passWithNoTests",
        "lint": "eslint --ext .ts,.tsx src",
        "synth": "npx cdk synth",
        "deploy": "npx cdk deploy --all --require-approval=never",
        "destroy": "npx cdk destroy --all --force",
        "diff": "npx cdk diff"
    },
    "dependencies": {
        "@aws-cdk/aws-bedrock-agentcore-alpha": "^2.223.0-alpha.0",
        "@aws-cdk/aws-lambda-python-alpha": "^2.232.1-alpha.0",
        "aws-cdk-lib": "^2.223.0",
        "cdk-nag": "^2.27.216",
        "constructs": "^10.3.0",
        "source-map-support": "^0.5.16"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^20.10.4",
        "aws-cdk": "^2",
        "jest": "^29.7.0",
        "ts-jest": "^29.4.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "jest": {
        "coverageProvider": "v8",
        "testMatch": [
            "<rootDir>/@(src|test)/**/*(*.)@(spec|test).ts?(x)"
        ],
        "transform": {
            "^.+\\.tsx?$": [
                "ts-jest",
                {
                    "tsconfig": "tsconfig.dev.json"
                }
            ]
        },
        "modulePathIgnorePatterns": [
            "<rootDir>/cdk.out/"
        ]
    }
}
